generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ProjectMediaKind {
  COVER
  GALLERY
}

enum SiteLinkKind {
  NAVIGATION
  FOOTER
  SOCIAL
}

model User {
  id        String    @id @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  profile       Profile?
  goals         Goal[]
  roadmaps      Roadmap[]
  roadmapStages RoadmapStage[]
  tasks         Task[]
  events        Event[]
  notes         Note[]
  projects      Project[]
  mediaAssets   MediaAsset[]
  experiences   Experience[]
  skills        Skill[]
  education     Education[]
  posts         Post[]
  contentSections ContentSection[]
  siteLinks      SiteLink[]
  faqs           Faq[]
  siteSetting    SiteSetting?

  @@index([deletedAt])
  @@map("users")
}

model SiteLink {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  kind         SiteLinkKind
  label        String        @db.VarChar(120)
  url          String        @db.VarChar(500)
  openNewTab   Boolean       @default(false) @map("open_new_tab")
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, deletedAt])
  @@index([kind, status, displayOrder, deletedAt])
  @@map("site_links")
}

model Faq {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  question     String        @db.VarChar(240)
  answer       String
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("faqs")
}

model SiteSetting {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @unique @map("user_id") @db.Uuid
  siteName       String        @map("site_name") @db.VarChar(120)
  tagline        String        @db.VarChar(240)
  footerText     String        @map("footer_text") @db.VarChar(500)
  privacyNote    String        @map("privacy_note")
  seoTitle       String        @map("seo_title") @db.VarChar(70)
  seoDescription String        @map("seo_description") @db.VarChar(180)
  canonicalUrl   String?       @map("canonical_url") @db.VarChar(500)
  seoImagePath   String?       @map("seo_image_path") @db.VarChar(500)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version        Int           @default(1)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, deletedAt])
  @@map("site_settings")
}

model Post {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  title        String        @db.VarChar(180)
  slug         String        @unique @db.VarChar(180)
  excerpt      String        @db.VarChar(320)
  body         String
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, deletedAt])
  @@index([status, publishedAt, deletedAt])
  @@map("posts")
}

model ContentSection {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  pageKey      String        @map("page_key") @db.VarChar(80)
  sectionKey   String        @map("section_key") @db.VarChar(80)
  heading      String        @db.VarChar(180)
  body         String
  ctaLabel     String?       @map("cta_label") @db.VarChar(120)
  ctaUrl       String?       @map("cta_url") @db.VarChar(500)
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, pageKey, sectionKey])
  @@index([userId, status, deletedAt])
  @@index([pageKey, status, displayOrder, deletedAt])
  @@map("content_sections")
}

model Experience {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  role         String        @db.VarChar(180)
  organization String        @db.VarChar(180)
  location     String?       @db.VarChar(180)
  description  String
  startedAt    DateTime      @map("started_at") @db.Date
  endedAt      DateTime?     @map("ended_at") @db.Date
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("experiences")
}

model Skill {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(120)
  category     String        @db.VarChar(120)
  proficiency  Int?
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("skills")
}

model Education {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  institution  String        @db.VarChar(180)
  degree       String        @db.VarChar(180)
  fieldOfStudy String?       @map("field_of_study") @db.VarChar(180)
  description  String?
  startedAt    DateTime?     @map("started_at") @db.Date
  endedAt      DateTime?     @map("ended_at") @db.Date
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("education")
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  title String @db.VarChar(180)
  slug String @unique @db.VarChar(180)
  summary String @db.VarChar(320)
  description String
  role String? @db.VarChar(180)
  techStack String[] @default([]) @map("tech_stack")
  githubUrl String? @map("github_url") @db.VarChar(500)
  liveUrl String? @map("live_url") @db.VarChar(500)
  status ContentStatus @default(DRAFT)
  startedAt DateTime? @map("started_at") @db.Date
  endedAt DateTime? @map("ended_at") @db.Date
  displayOrder Int @default(0) @map("display_order")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  media ProjectMedia[]
  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("projects")
}

model MediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  bucket String @db.VarChar(63)
  objectPath String @unique @map("object_path") @db.VarChar(500)
  originalName String @map("original_name") @db.VarChar(255)
  mimeType String @map("mime_type") @db.VarChar(100)
  sizeBytes Int @map("size_bytes")
  altText String @map("alt_text") @db.VarChar(240)
  width Int?
  height Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectMedia[]
  @@index([userId, deletedAt])
  @@map("media_assets")
}

model ProjectMedia {
  projectId String @map("project_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  kind ProjectMediaKind @default(GALLERY)
  displayOrder Int @default(0) @map("display_order")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  @@id([projectId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([projectId, kind, displayOrder])
  @@map("project_media")
}

model Profile {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  displayName String?   @map("display_name") @db.VarChar(120)
  headline    String?   @db.VarChar(180)
  bio         String?
  avatarPath  String?   @map("avatar_path")
  avatarAlt   String?   @map("avatar_alt") @db.VarChar(240)
  avatarMimeType String? @map("avatar_mime_type") @db.VarChar(100)
  avatarSizeBytes Int?  @map("avatar_size_bytes")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("profiles")
}

model Goal {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  title           String     @db.VarChar(180)
  description     String?
  status          GoalStatus @default(DRAFT)
  priority        Priority   @default(MEDIUM)
  deadline        DateTime?  @db.Timestamptz(6)
  successCriteria Json?      @map("success_criteria") @db.JsonB
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  version         Int        @default(1)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps Roadmap[]
  tasks    Task[]

  @@index([userId, status, deletedAt])
  @@index([userId, deadline])
  @@unique([id, userId])
  @@map("goals")
}

model Roadmap {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  goalId      String    @map("goal_id") @db.Uuid
  title       String    @db.VarChar(180)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal           @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  stages RoadmapStage[]
  tasks  Task[]

  @@index([userId, deletedAt])
  @@index([goalId])
  @@index([goalId, userId])
  @@unique([id, userId])
  @@map("roadmaps")
}

model RoadmapStage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roadmapId   String    @map("roadmap_id") @db.Uuid
  title       String    @db.VarChar(180)
  description String?
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId, userId], references: [id, userId], onDelete: Cascade)
  tasks   Task[]

  @@unique([roadmapId, position])
  @@index([userId, deletedAt])
  @@index([roadmapId, deletedAt])
  @@index([roadmapId, userId])
  @@unique([id, userId])
  @@map("roadmap_stages")
}

model Task {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  goalId         String?    @map("goal_id") @db.Uuid
  roadmapId      String?    @map("roadmap_id") @db.Uuid
  roadmapStageId String?    @map("roadmap_stage_id") @db.Uuid
  title          String     @db.VarChar(220)
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueAt          DateTime?  @map("due_at") @db.Timestamptz(6)
  position       Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  version        Int        @default(1)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal?         @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  roadmap      Roadmap?      @relation(fields: [roadmapId, userId], references: [id, userId], onDelete: Restrict)
  roadmapStage RoadmapStage? @relation(fields: [roadmapStageId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, status, deletedAt])
  @@index([userId, dueAt])
  @@index([goalId])
  @@index([goalId, userId])
  @@index([roadmapId])
  @@index([roadmapId, userId])
  @@index([roadmapStageId])
  @@index([roadmapStageId, userId])
  @@map("tasks")
}

model Event {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(220)
  description String?
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  timezone    String    @default("UTC") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([userId, deletedAt])
  @@map("events")
}

model Note {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(220)
  content   String    @default("")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("notes")
}
