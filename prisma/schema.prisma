generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum RoadmapStageStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
  SKIPPED
}

enum EventRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AIProposalStatus {
  DRAFT
  COMMITTED
  DISCARDED
  FAILED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProjectMediaKind {
  COVER
  GALLERY
}

enum SiteLinkKind {
  NAVIGATION
  FOOTER
  SOCIAL
}

model User {
  id        String    @id @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  profile                Profile?
  goals                  Goal[]
  roadmaps               Roadmap[]
  roadmapStages          RoadmapStage[]
  tasks                  Task[]
  events                 Event[]
  notes                  Note[]
  checklists             Checklist[]
  checklistItems         ChecklistItem[]
  reminders              Reminder[]
  notificationPreference NotificationPreference?
  aiProposals            AIProposal[]
  aiActionLogs           AIActionLog[]
  aiConversations        AIConversation[]
  aiMessages             AIMessage[]
  aiSetting              AISetting?
  projects               Project[]
  mediaAssets            MediaAsset[]
  experiences            Experience[]
  skills                 Skill[]
  education              Education[]
  posts                  Post[]
  contentSections        ContentSection[]
  siteLinks              SiteLink[]
  faqs                   Faq[]
  siteSetting            SiteSetting?

  @@index([deletedAt])
  @@map("users")
}

model AIProposal {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  action         String           @db.VarChar(80)
  status         AIProposalStatus @default(DRAFT)
  payload        Json             @db.JsonB
  payloadHash    String           @map("payload_hash") @db.VarChar(64)
  confirmationId String           @unique @map("confirmation_id") @db.Uuid
  result         Json?            @db.JsonB
  committedAt    DateTime?        @map("committed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int              @default(1)

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs AIActionLog[]

  @@unique([id, userId])
  @@index([userId, status, updatedAt])
  @@map("ai_proposals")
}

model AIConversation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String    @db.VarChar(160)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version    Int       @default(1)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@unique([id, userId])
  @@index([userId, archivedAt, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AIMessageRole
  content        String
  contextSummary Json?         @map("context_summary") @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_messages")
}

model AISetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  enabled        Boolean  @default(true)
  historyEnabled Boolean  @default(true) @map("history_enabled")
  includeGoals   Boolean  @default(true) @map("include_goals")
  includeTasks   Boolean  @default(true) @map("include_tasks")
  includeNotes   Boolean  @default(false) @map("include_notes")
  retentionDays  Int      @default(30) @map("retention_days")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AIActionLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  proposalId     String   @map("proposal_id") @db.Uuid
  action         String   @db.VarChar(80)
  status         String   @db.VarChar(40)
  payloadHash    String   @map("payload_hash") @db.VarChar(64)
  confirmationId String?  @map("confirmation_id") @db.Uuid
  details        Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal AIProposal @relation(fields: [proposalId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([proposalId, createdAt])
  @@map("ai_action_logs")
}

model SiteLink {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  kind         SiteLinkKind
  label        String        @db.VarChar(120)
  url          String        @db.VarChar(500)
  openNewTab   Boolean       @default(false) @map("open_new_tab")
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@index([kind, status, displayOrder, deletedAt])
  @@map("site_links")
}

model Faq {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  question     String        @db.VarChar(240)
  answer       String
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("faqs")
}

model SiteSetting {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @unique @map("user_id") @db.Uuid
  siteName       String        @map("site_name") @db.VarChar(120)
  tagline        String        @db.VarChar(240)
  footerText     String        @map("footer_text") @db.VarChar(500)
  privacyNote    String        @map("privacy_note")
  seoTitle       String        @map("seo_title") @db.VarChar(70)
  seoDescription String        @map("seo_description") @db.VarChar(180)
  canonicalUrl   String?       @map("canonical_url") @db.VarChar(500)
  seoImagePath   String?       @map("seo_image_path") @db.VarChar(500)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version        Int           @default(1)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, deletedAt])
  @@map("site_settings")
}

model Post {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  title        String        @db.VarChar(180)
  slug         String        @unique @db.VarChar(180)
  excerpt      String        @db.VarChar(320)
  body         String
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@index([status, publishedAt, deletedAt])
  @@map("posts")
}

model ContentSection {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  pageKey      String        @map("page_key") @db.VarChar(80)
  sectionKey   String        @map("section_key") @db.VarChar(80)
  heading      String        @db.VarChar(180)
  body         String
  ctaLabel     String?       @map("cta_label") @db.VarChar(120)
  ctaUrl       String?       @map("cta_url") @db.VarChar(500)
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey, sectionKey])
  @@index([userId, status, deletedAt])
  @@index([pageKey, status, displayOrder, deletedAt])
  @@map("content_sections")
}

model Experience {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  role         String        @db.VarChar(180)
  organization String        @db.VarChar(180)
  location     String?       @db.VarChar(180)
  description  String
  startedAt    DateTime      @map("started_at") @db.Date
  endedAt      DateTime?     @map("ended_at") @db.Date
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("experiences")
}

model Skill {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(120)
  category     String        @db.VarChar(120)
  proficiency  Int?
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("skills")
}

model Education {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  institution  String        @db.VarChar(180)
  degree       String        @db.VarChar(180)
  fieldOfStudy String?       @map("field_of_study") @db.VarChar(180)
  description  String?
  startedAt    DateTime?     @map("started_at") @db.Date
  endedAt      DateTime?     @map("ended_at") @db.Date
  status       ContentStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version      Int           @default(1)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("education")
}

model Project {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  title        String         @db.VarChar(180)
  slug         String         @unique @db.VarChar(180)
  summary      String         @db.VarChar(320)
  description  String
  role         String?        @db.VarChar(180)
  techStack    String[]       @default([]) @map("tech_stack")
  githubUrl    String?        @map("github_url") @db.VarChar(500)
  liveUrl      String?        @map("live_url") @db.VarChar(500)
  status       ContentStatus  @default(DRAFT)
  startedAt    DateTime?      @map("started_at") @db.Date
  endedAt      DateTime?      @map("ended_at") @db.Date
  displayOrder Int            @default(0) @map("display_order")
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  version      Int            @default(1)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media        ProjectMedia[]

  @@index([userId, status, deletedAt])
  @@index([status, displayOrder, deletedAt])
  @@map("projects")
}

model MediaAsset {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  bucket       String         @db.VarChar(63)
  objectPath   String         @unique @map("object_path") @db.VarChar(500)
  originalName String         @map("original_name") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    Int            @map("size_bytes")
  altText      String         @map("alt_text") @db.VarChar(240)
  width        Int?
  height       Int?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects     ProjectMedia[]

  @@index([userId, deletedAt])
  @@map("media_assets")
}

model ProjectMedia {
  projectId    String           @map("project_id") @db.Uuid
  mediaAssetId String           @map("media_asset_id") @db.Uuid
  kind         ProjectMediaKind @default(GALLERY)
  displayOrder Int              @default(0) @map("display_order")
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([projectId, kind, displayOrder])
  @@map("project_media")
}

model Profile {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @unique @map("user_id") @db.Uuid
  displayName     String?       @map("display_name") @db.VarChar(120)
  workspaceName   String?       @map("workspace_name") @db.VarChar(120)
  timezone        String        @default("UTC") @db.VarChar(64)
  headline        String?       @db.VarChar(180)
  bio             String?
  avatarPath      String?       @map("avatar_path")
  avatarAlt       String?       @map("avatar_alt") @db.VarChar(240)
  avatarMimeType  String?       @map("avatar_mime_type") @db.VarChar(100)
  avatarSizeBytes Int?          @map("avatar_size_bytes")
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  version         Int           @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("profiles")
}

model Goal {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  title           String     @db.VarChar(180)
  description     String?
  status          GoalStatus @default(DRAFT)
  priority        Priority   @default(MEDIUM)
  deadline        DateTime?  @db.Timestamptz(6)
  startsAt        DateTime?  @map("starts_at") @db.Timestamptz(6)
  successCriteria Json?      @map("success_criteria") @db.JsonB
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  version         Int        @default(1)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps   Roadmap[]
  tasks      Task[]
  events     Event[]
  checklists Checklist[]
  reminders  Reminder[]
  notes      Note[]

  @@unique([id, userId])
  @@index([userId, status, deletedAt])
  @@index([userId, deadline])
  @@map("goals")
}

model Roadmap {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  goalId      String    @map("goal_id") @db.Uuid
  title       String    @db.VarChar(180)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal           @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  stages     RoadmapStage[]
  tasks      Task[]
  checklists Checklist[]
  notes      Note[]

  @@unique([id, userId])
  @@index([userId, deletedAt])
  @@index([goalId])
  @@index([goalId, userId])
  @@map("roadmaps")
}

model RoadmapStage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roadmapId   String    @map("roadmap_id") @db.Uuid
  title       String    @db.VarChar(180)
  description String?
  position    Int
  startsAt    DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?          @map("ends_at") @db.Timestamptz(6)
  status      RoadmapStageStatus @default(PLANNED)
  successCriteria Json?          @map("success_criteria") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId, userId], references: [id, userId], onDelete: Cascade)
  tasks   Task[]
  notes   Note[]

  @@unique([roadmapId, position])
  @@unique([id, userId])
  @@index([userId, deletedAt])
  @@index([roadmapId, deletedAt])
  @@index([roadmapId, userId])
  @@map("roadmap_stages")
}

model Task {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  goalId         String?    @map("goal_id") @db.Uuid
  roadmapId      String?    @map("roadmap_id") @db.Uuid
  roadmapStageId String?    @map("roadmap_stage_id") @db.Uuid
  title          String     @db.VarChar(220)
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueAt          DateTime?  @map("due_at") @db.Timestamptz(6)
  estimatedMinutes Int?     @map("estimated_minutes")
  expectedResult String?    @map("expected_result")
  resources      Json?      @db.JsonB
  source         String?    @db.VarChar(160)
  externalKey    String?    @map("external_key") @db.VarChar(255)
  isOptional     Boolean    @default(false) @map("is_optional")
  position       Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  version        Int        @default(1)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal?         @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  roadmap      Roadmap?      @relation(fields: [roadmapId, userId], references: [id, userId], onDelete: Restrict)
  roadmapStage RoadmapStage? @relation(fields: [roadmapStageId, userId], references: [id, userId], onDelete: Restrict)
  events       Event[]
  checklists   Checklist[]
  reminders    Reminder[]
  notes        Note[]

  @@unique([id, userId])
  @@index([userId, status, deletedAt])
  @@index([userId, dueAt])
  @@index([goalId])
  @@index([goalId, userId])
  @@index([roadmapId])
  @@index([roadmapId, userId])
  @@index([roadmapStageId])
  @@index([roadmapStageId, userId])
  @@index([userId, externalKey])
  @@map("tasks")
}

model Event {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  goalId      String?         @map("goal_id") @db.Uuid
  taskId      String?         @map("task_id") @db.Uuid
  title       String          @db.VarChar(220)
  description String?
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?       @map("ends_at") @db.Timestamptz(6)
  timezone    String          @default("UTC") @db.VarChar(64)
  recurrence  EventRecurrence @default(NONE)
  source      String?         @db.VarChar(160)
  externalKey String?         @map("external_key") @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)
  version     Int             @default(1)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal?      @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  task      Task?      @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  reminders Reminder[]
  notes     Note[]

  @@unique([id, userId])
  @@index([userId, startsAt])
  @@index([userId, deletedAt])
  @@index([goalId, userId])
  @@index([taskId, userId])
  @@index([userId, externalKey])
  @@map("events")
}

model Note {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  goalId    String?   @map("goal_id") @db.Uuid
  roadmapId String?   @map("roadmap_id") @db.Uuid
  roadmapStageId String? @map("roadmap_stage_id") @db.Uuid
  taskId    String?   @map("task_id") @db.Uuid
  eventId   String?   @map("event_id") @db.Uuid
  title     String    @db.VarChar(220)
  content   String    @default("")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  roadmap Roadmap? @relation(fields: [roadmapId, userId], references: [id, userId], onDelete: Restrict)
  roadmapStage RoadmapStage? @relation(fields: [roadmapStageId, userId], references: [id, userId], onDelete: Restrict)
  task Task? @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  event Event? @relation(fields: [eventId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@index([goalId, userId])
  @@index([roadmapId, userId])
  @@index([roadmapStageId, userId])
  @@index([taskId, userId])
  @@index([eventId, userId])
  @@map("notes")
}

model Checklist {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  goalId      String?   @map("goal_id") @db.Uuid
  roadmapId   String?   @map("roadmap_id") @db.Uuid
  taskId      String?   @map("task_id") @db.Uuid
  title       String    @db.VarChar(220)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal?           @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  roadmap   Roadmap?        @relation(fields: [roadmapId, userId], references: [id, userId], onDelete: Restrict)
  task      Task?           @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  items     ChecklistItem[]
  reminders Reminder[]

  @@unique([id, userId])
  @@index([userId, deletedAt])
  @@index([userId, updatedAt])
  @@index([goalId, userId])
  @@index([roadmapId, userId])
  @@index([taskId, userId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  checklistId String    @map("checklist_id") @db.Uuid
  title       String    @db.VarChar(220)
  completed   Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([checklistId, position])
  @@unique([id, userId])
  @@index([userId, deletedAt])
  @@index([checklistId, deletedAt])
  @@index([checklistId, userId])
  @@map("checklist_items")
}

model Reminder {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  goalId       String?            @map("goal_id") @db.Uuid
  taskId       String?            @map("task_id") @db.Uuid
  eventId      String?            @map("event_id") @db.Uuid
  checklistId  String?            @map("checklist_id") @db.Uuid
  title        String             @db.VarChar(220)
  scheduledFor DateTime           @map("scheduled_for") @db.Timestamptz(6)
  timezone     String             @default("UTC") @db.VarChar(64)
  recurrence   ReminderRecurrence @default(NONE)
  status       ReminderStatus     @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  version      Int                @default(1)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal?      @relation(fields: [goalId, userId], references: [id, userId], onDelete: Restrict)
  task      Task?      @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  event     Event?     @relation(fields: [eventId, userId], references: [id, userId], onDelete: Restrict)
  checklist Checklist? @relation(fields: [checklistId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, status, scheduledFor])
  @@index([goalId, userId])
  @@index([taskId, userId])
  @@index([eventId, userId])
  @@index([checklistId, userId])
  @@map("reminders")
}

model NotificationPreference {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  inAppEnabled       Boolean  @default(true) @map("in_app_enabled")
  browserEnabled     Boolean  @default(false) @map("browser_enabled")
  defaultLeadMinutes Int      @default(15) @map("default_lead_minutes")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
