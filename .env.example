# Copy to .env.local and replace placeholders. Never commit real values.

# Browser-safe application and Supabase configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Runtime uses the pooled URL supplied by Supabase.
DATABASE_URL="your-pooled-runtime-connection-string"
# Prisma migrations and backup tools use the direct URL supplied by Supabase.
DIRECT_URL="your-direct-migration-connection-string"

# Existing Supabase Auth user UUID used by the idempotent development seed.
SEED_USER_ID="your-development-auth-user-id"

# AI feature flags (server-only)
AI_ENABLED="false"
AI_USE_MOCK_PROVIDER="true"
AI_STREAMING_ENABLED="false"
AI_LOGGING_ENABLED="false"

# Provider priority and models (server-only)
DEFAULT_AI_PROVIDER="openai"
AI_PROVIDER_FALLBACK_ORDER="openai,groq,gemini,mock"
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL=""
GROQ_API_KEY=""
GROQ_DEFAULT_MODEL=""
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL=""

# AI limits (server-only)
AI_REQUEST_TIMEOUT_MS="30000"
AI_RETRY_LIMIT="1"
AI_MAX_OUTPUT_TOKENS="4000"
AI_CONTEXT_TOKEN_LIMIT="8000"
AI_PAYLOAD_MAX_CHARACTERS="4000"
